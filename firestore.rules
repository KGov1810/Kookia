rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un foyer n'est lisible que si l'on connaît son code (pas de listing possible).
    match /foyers/{code} {
      allow get, create: if request.auth != null;
      allow list, update, delete: if false;

      // Stock, liste de courses et recettes du foyer.
      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && collection in ['produits', 'courses', 'recettes']
          && exists(/databases/$(database)/documents/foyers/$(code));
      }

      // Historique : lecture, ajout et nettoyage des entrées anciennes ; jamais de modification.
      match /historique/{entryId} {
        allow read, create, delete: if request.auth != null
          && exists(/databases/$(database)/documents/foyers/$(code));
      }
    }
  }
}
